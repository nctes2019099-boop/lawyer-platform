# Database connection (SQLite by default)
DATABASE_URL="file:./dev.db"

# Session signing secret. REQUIRED in production — use a long random string
# (e.g. `openssl rand -base64 32`). The dev fallback is for local use only.
NEXTAUTH_SECRET="change-me-to-a-long-random-secret"

# Auto-login as demo@lawyer.com — DEVELOPMENT ONLY.
# This is forcibly ignored when NODE_ENV=production.
DEV_AUTO_LOGIN="true"

NODE_ENV="development"

# Payment / webhook settings (optional)
WEBHOOK_SECRET=""
WEBHOOK_ALLOWED_IPS=""
PAYMENT_PROVIDER="mock"
ZAINCASH_TOKEN=""
ZAINCASH_SECRET=""

# Public site URL (used for Open Graph images / canonical links)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# For native/mobile builds: absolute URL of the backend API.
# Leave empty for same-origin web usage.
NEXT_PUBLIC_API_URL=""

# Optional: dev server URL for Capacitor live reload (e.g. http://10.0.2.2:3000)
CAP_SERVER_URL=""
