# Database connection (SQLite by default)
DATABASE_URL="file:./dev.db"

# Session signing secret. REQUIRED in production — use a long random string
# (e.g. `openssl rand -base64 32`). The dev fallback is for local use only.
NEXTAUTH_SECRET="change-me-to-a-long-random-secret"

# Auto-login as demo@lawyer.com — DEVELOPMENT ONLY.
# This is forcibly ignored when NODE_ENV=production.
DEV_AUTO_LOGIN="true"

NODE_ENV="development"

# Payment / webhook settings (optional)
WEBHOOK_SECRET=""
WEBHOOK_ALLOWED_IPS=""
PAYMENT_PROVIDER="mock"
ZAINCASH_TOKEN=""
ZAINCASH_SECRET=""
