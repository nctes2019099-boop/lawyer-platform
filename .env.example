# ─────────────────────────────────────────────────────────────
#  ميزان — بيئة التطبيق
#  انسخ هذا الملف إلى .env واضبط القيم قبل التشغيل.
#  docker-compose.yml يقرأ القيم نفسها من .env تلقائياً.
# ─────────────────────────────────────────────────────────────

# Database connection (SQLite by default).
# In Docker: file:/data/prod.db  (mapped to the mizan-data volume)
DATABASE_URL="file:./dev.db"

# Session signing secret. REQUIRED in production — use a long random string
# (e.g. `openssl rand -base64 32`). The dev fallback is for local use only.
NEXTAUTH_SECRET="change-me-to-a-long-random-secret"

# Public base URL of the deployed site (used in auth, payment redirects, emails).
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

NODE_ENV="development"

# Auto-login as demo@lawyer.com — DEVELOPMENT ONLY.
# This is forcibly ignored when NODE_ENV=production.
DEV_AUTO_LOGIN="true"

# ── File uploads ──────────────────────────────────────────────
# Directory where uploaded documents are stored. In Docker this is /data/uploads
# (a mounted volume) so files survive container restarts.
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB="20"

# ── ZainCash Iraq (electronic payments) ───────────────────────
# احصل على هذه القيم من زين كاش. اضبط ZAINCASH_SANDBOX=false للدفع الحقيقي.
ZAINCASH_MERCHANT_ID=""
ZAINCASH_MSISDN=""
ZAINCASH_TOKEN=""
ZAINCASH_SECRET=""
# "true" = وضع الاختبار | "false" = دفع حقيقي
ZAINCASH_SANDBOX="true"

# Generic webhook security (optional)
WEBHOOK_SECRET=""
WEBHOOK_ALLOWED_IPS=""
PAYMENT_PROVIDER="zaincash"

# ── Transactional email (Resend) ─────────────────────────────
# أنشئ مفتاحاً على https://resend.com ودعمه هنا لإرسال رسائل الترحيب والإيصالات.
RESEND_API_KEY=""
# البريد الذي تُرسل إليه رسائل نموذج "تواصل معنا"
CONTACT_EMAIL="support@mizan.app"

# ── First admin account (seeded once on first boot in Docker) ─
SEED_ADMIN_EMAIL="admin@mizan.app"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="مدير النظام"

# ── Mobile / native builds (Capacitor) ───────────────────────
# For native/mobile builds: absolute URL of the backend API.
# Leave empty for same-origin web usage.
NEXT_PUBLIC_API_URL=""
# Optional: dev server URL for Capacitor live reload (e.g. http://10.0.2.2:3000)
CAP_SERVER_URL=""

# ── Speech-to-text (optional) ────────────────────────────────
# If unset, the app uses the browser's Web Speech API and the transcribe
# endpoint returns 503.
STT_ENDPOINT=""
STT_API_KEY=""
